# ---------------------------------------------------------------------------
# Razorpay. Copy to `.env.local` for `vercel dev`, or set these in the Vercel
# dashboard under Settings -> Environment Variables.
#
# Test keys first. Razorpay Dashboard -> Account & Settings -> API Keys.
# Test keys start rzp_test_, live keys start rzp_live_.
# ---------------------------------------------------------------------------

# Server-only. Creates orders and verifies payment signatures.
# NEVER prefix this with VITE_ — anything VITE_-prefixed is inlined into the
# JavaScript bundle and readable by anyone who loads the page.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed if the order API lives somewhere other than the same
# origin as the site (e.g. a separate backend). Leave blank in normal use.
# VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Support contact, shown on the order confirmation, the invoice and My Orders.
#
# VITE_-prefixed values are inlined into the public JS bundle. That is correct
# here: a support number and handle are public, and this is how you change them
# without a code edit. NEVER put a secret behind a VITE_ prefix.
#
# Digits only, with the country code and no "+". India is assumed if you leave
# the 91 off a 10-digit number.
# ---------------------------------------------------------------------------
VITE_WHATSAPP_NUMBER=919876543210

# The address buyers are told to contact about an order. Shown on the order
# confirmation and printed on the invoice. Leave blank and the email links are
# hidden rather than rendered broken.
VITE_CONTACT_EMAIL=orders@example.com
