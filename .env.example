# ---------------------------------------------------------------------------
# Razorpay. Copy to `.env.local` for `vercel dev`, or set these in the Vercel
# dashboard under Settings -> Environment Variables.
#
# Test keys first. Razorpay Dashboard -> Account & Settings -> API Keys.
# Test keys start rzp_test_, live keys start rzp_live_.
# ---------------------------------------------------------------------------

# Server-only. Creates orders and verifies payment signatures.
# NEVER prefix this with VITE_ — anything VITE_-prefixed is inlined into the
# JavaScript bundle and readable by anyone who loads the page.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Only needed if the order API lives somewhere other than the same
# origin as the site (e.g. a separate backend). Leave blank in normal use.
# VITE_API_BASE_URL=
